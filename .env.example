# =============================================================================
# AgentCart environment variables
# Copy to .env (`./scripts/setup-env.sh` does this and generates secrets for you).
# Never commit .env. Everything here works locally without any paid API key.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
# development | test | production. Production refuses to start without a strong JWT_SECRET
# and disables the interactive API docs.
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Database (PostgreSQL) ---------------------------------------------------
# Used by docker-compose to create the database container.
POSTGRES_USER=agentcart
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=agentcart
# Host port for the Postgres container (5433 avoids clashing with a local Postgres on 5432).
POSTGRES_PORT=5433
# SQLAlchemy URL used by the backend, Alembic and the seed script when running on the host.
# (Inside docker-compose the backend overrides the host to `db:5432`.)
DATABASE_URL=postgresql+psycopg://agentcart:change-me-local-only@localhost:5433/agentcart

# --- Auth --------------------------------------------------------------------
# Random string, at least 32 characters. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# If empty in development, an ephemeral secret is generated on each start (tokens reset).
JWT_SECRET=
# Access-token lifetime in minutes (5–1440).
JWT_EXPIRE_MINUTES=60

# --- HTTP --------------------------------------------------------------------
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# In-process rate limiting (per IP for auth, per user for chat/writes), requests per minute.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_WRITE_PER_MINUTE=60
# Proxies in front of the API that append to X-Forwarded-For (local nginx; Render's load balancer).
# The client IP for rate limiting is the entry this many places from the right; client-supplied
# entries further left are ignored. 0 = ignore the header and use the connection's address.
# Never set it higher than the number of proxies that append, or clients can bypass the limit
# (see docs/SECURITY.md, and verify after deploying with docs/DEPLOYMENT.md step 5.2).
TRUSTED_PROXY_HOPS=1

# --- AI provider ---------------------------------------------------------------
# mock (default, deterministic, no network) | ollama | openai_compatible | anthropic
LLM_PROVIDER=mock
# Per-call timeout, retry count and the overall agent deadline (seconds).
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2
AGENT_DEADLINE_SECONDS=45

# Ollama (local models). From Docker use http://host.docker.internal:11434
# or the bundled `ollama` compose profile: http://ollama:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Any OpenAI-compatible endpoint (Groq, OpenRouter, Together, LM Studio, vLLM …). Optional.
HOSTED_LLM_BASE_URL=https://api.groq.com/openai/v1
HOSTED_LLM_API_KEY=
HOSTED_LLM_MODEL=llama-3.1-8b-instant

# Anthropic Messages API. Optional.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# --- Ranking weights (relative; normalised to sum to 1) ------------------------
RANK_WEIGHT_BUDGET=0.25
RANK_WEIGHT_SPEC=0.30
RANK_WEIGHT_RATING=0.20
RANK_WEIGHT_PREFERENCE=0.25

# --- Commerce rules ------------------------------------------------------------
MAX_ITEM_QUANTITY=10
MAX_CART_LINES=30
SHIPPING_FEE_INR=99
FREE_SHIPPING_THRESHOLD_INR=999
CHECKOUT_QUOTE_TTL_SECONDS=600
AGENT_ACTION_TTL_MINUTES=30
# Persistent agent tasks: attempts per step, retry backoff (doubles per retry), runner lease,
# and how many queued/running tasks one user may have.
TASK_STEP_MAX_ATTEMPTS=3
TASK_RETRY_BACKOFF_SECONDS=0.5
TASK_LEASE_SECONDS=120
TASK_MAX_ACTIVE_PER_USER=5

# --- Frontend (Vite, read at build time) ---------------------------------------
# Base URL of the API as seen from the browser. Leave empty to use the same origin
# (Vite dev proxy / nginx proxy forward /api to the backend).
VITE_API_BASE_URL=
